#!/usr/bin/env bash
# Usage: review-commits COMMIT
#    or: review-commits BASE..LAST
#
# Gets COMMIT, or the commits after BASE up to and including LAST, reviewed by
# every reviewer below at xhigh reasoning, all at once, in a `git clone --shared`
# of the current repository with COMMIT (or LAST) checked out. Saves each review
# to ~/.ai-code-reviews/MODEL/NAME, where NAME is the full hash of COMMIT, or
# FULL_BASE..FULL_LAST; next to its review, a codex reviewer's transcript goes
# to NAME.log, and a Claude reviewer's session files go to the directory
# NAME.transcript. Prints the reviews in the order that the reviewers started,
# each once its reviewer and every reviewer started before it have exited. Once
# every reviewer has exited, deletes the clone, and exits with status 1 if any
# reviewer failed. On SIGINT or SIGTERM, stops every reviewer together with the
# processes it started, deletes the clone, and exits with status 130 or 143.
# Runs each reviewer in a bwrap sandbox (see make_sandbox), and exits with
# status 2 if bwrap is not on PATH.

set -euo pipefail

# Each codex reviewer is MODEL:FOCUS. It runs `codex exec` with a prompt that
# names what to review, followed by review-prompts/codex-FOCUS.md and then
# review-prompts/codex-common.md. Reviewers with different focuses find
# different problems; `codex review` is not used, because its built-in rubric
# tells the model to prefer reporting nothing. Each model appears only once
# among all the reviewers, because its reviews are saved under its name.
codex_reviewers=(gpt-6-astra:general gpt-6.1-sol:approach gpt-5.6-sol:text)
claude_reviewers=(claude-mythos-5-1 claude-opus-5-5)
# Reviews in place of a Claude reviewer's model where that model is not
# available to the logged-in account (e.g. an account without Mythos) or keeps
# being overloaded, but not where the account has hit that model's usage limit.
# Its review is saved under the reviewer's model.
claude_fallback_model=claude-fable-5-1
# What a Claude reviewer can read in the home directory besides claude's own
# files and the hooks in claude's settings: the files that those hooks read.
# The outbound-firewall hook denies every command without its config.
claude_hook_files=(.config/claude-outbound-firewall)

# The temporary directory that holds the clone; cleanup() deletes it.
tmp=

# Prints $1 and the usage to stderr, then exits with status 2.
die_usage() {
	echo "review-commits: $1" >&2
	echo "Usage: review-commits COMMIT, or review-commits BASE..LAST" >&2
	exit 2
}

# Prints the full hash of commit $1 of the current repository, or exits with
# status 2 through die_usage. Inside `var=$(full_hash ...)`, that exit ends only
# the subshell, and `set -e` then ends the script. So never call it as
# `local var=$(full_hash ...)` or in a condition, which hide the failure.
full_hash() {
	git rev-parse --verify --quiet "$1^{commit}" || die_usage "not a commit: $1"
}

# Sets the array `sandbox` (which main declares) to the start of a bwrap
# command line that runs a reviewer without letting it read other reviews of
# the same commits: it hides the home directory (~/.ai-code-reviews, and the
# transcripts of claude and codex), /tmp, /var/tmp and the directory that $tmp
# is in (the clones and files of other runs), and other processes. The
# reviewer still gets, read-only: the objects that the clone in $tmp/repo
# borrows, every directory on PATH that is in the home directory, and ~/.rustup
# (the toolchains that rustup's rustc and cargo run). A link in one of those
# directories to elsewhere in the home directory, such as uv's
# ~/.local/bin/python3, is broken in the sandbox. The reviewer also gets $tmp.
# codex_home_options and claude_home_options make the rest of the options for
# each kind of reviewer.
make_sandbox() {
	sandbox=(bwrap --ro-bind / / --dev /dev --proc /proc --unshare-pid --die-with-parent
		--tmpfs "$HOME" --tmpfs /tmp --tmpfs /var/tmp)
	local dir
	local -a path_dirs
	while read -r dir; do
		sandbox+=(--ro-bind "$dir" "$dir")
	done < "$tmp/repo/.git/objects/info/alternates"
	IFS=: read -ra path_dirs <<< "$PATH"
	for dir in "${path_dirs[@]}" "$HOME/.rustup"; do
		if [[ $dir == "$HOME"/* && -d $dir ]]; then
			sandbox+=(--ro-bind "$dir" "$dir")
		fi
	done
	sandbox+=(--tmpfs "${tmp%/*}" --bind "$tmp" "$tmp")
}

# Sets the array `codex_options` (which main declares) to the rest of the bwrap
# options for a codex reviewer, ending in `--`: codex's directory (~/.codex, or
# CODEX_HOME), empty but for its config.toml and auth.json. Codex rewrites auth.json in place to save refreshed tokens,
# holding a lock on auth.lock, so every codex reviewer gets the same auth.lock
# (made here if missing), writable, and refreshes don't race.
codex_home_options() {
	local codex_home=${CODEX_HOME:-$HOME/.codex}
	if [[ -d $codex_home ]]; then
		: >> "$codex_home/auth.lock"
	fi
	codex_options=(--tmpfs "$codex_home"
		--bind-try "$codex_home/auth.json" "$codex_home/auth.json"
		--bind-try "$codex_home/auth.lock" "$codex_home/auth.lock"
		--ro-bind-try "$codex_home/config.toml" "$codex_home/config.toml" --)
}

# Sets the array `claude_options` (which main declares) to the rest of the
# bwrap options for a Claude reviewer, ending in `--`: claude's directory
# (~/.claude), showing only its login, settings, plugins and skills. Each other
# file in it can't be read, and each other directory is empty, except that
# `projects`, where claude saves its sessions, is the directory $1. Claude
# rewrites its login in place to save refreshed tokens, holding a lock that it
# makes in its directory, so the reviewer gets the directory itself, writable,
# and refreshes don't race. The reviewer also gets, read-only, the directory of
# each hook command in claude's settings that is in the home directory, and
# claude_hook_files.
claude_home_options() {
	local claude_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude} entry hook file
	claude_options=(--bind-try "$claude_dir" "$claude_dir")
	while IFS= read -r -d '' entry; do
		case ${entry##*/} in
			.credentials.json | settings.json | plugins | skills | projects) ;;
			*)
				if [[ -d $entry ]]; then
					claude_options+=(--tmpfs "$entry")
				elif [[ -e $entry ]]; then
					claude_options+=(--ro-bind /dev/null "$entry")
				fi
				;;
		esac
	done < <(find "$claude_dir" -mindepth 1 -maxdepth 1 -print0 2> /dev/null)
	claude_options+=(--bind "$1" "$claude_dir/projects")
	if [[ -r $claude_dir/settings.json ]]; then
		while IFS= read -r hook; do
			hook=${hook%% *}
			hook=${hook/#\~/$HOME}
			if [[ $hook == "$HOME"/* ]]; then
				claude_options+=(--ro-bind-try "${hook%/*}" "${hook%/*}")
			fi
		done < <(jq -r '.hooks[]?[]?.hooks[]?.command' "$claude_dir/settings.json")
	fi
	for file in "${claude_hook_files[@]}"; do
		claude_options+=(--ro-bind-try "$HOME/$file" "$HOME/$file")
	done
	claude_options+=(--)
}

# Stops every reviewer still running, together with the processes it started,
# waits for them to exit, then deletes the clone.
cleanup() {
	local pid
	# `jobs -pr` lists only the reviewers still running, so a PID that the
	# system reused after its reviewer exited is never signalled. Each reviewer
	# leads a process group of its own, which `kill -- -PID` signals as a whole.
	for pid in $(jobs -pr); do
		kill -TERM -- "-$pid" 2>/dev/null || true
	done
	wait || true
	if [[ -n $tmp ]]; then
		rm -rf "$tmp"
	fi
}

main() {
	if (( $# != 1 )); then
		die_usage "expected one argument, got $#"
	fi
	local arg=$1
	if [[ $arg == *...* ]]; then
		die_usage "BASE...LAST (with three dots) is not supported: $arg"
	fi

	# What the reviewers get told to review, and the review files' name
	local base last name claude_target codex_target
	if [[ $arg == *..* ]]; then
		base=$(full_hash "${arg%%..*}")
		last=$(full_hash "${arg#*..}")
		if [[ $base == "$last" ]] || ! git merge-base --is-ancestor "$base" "$last"; then
			die_usage "BASE must be an ancestor of LAST, and not LAST itself: $arg"
		fi
		name=$base..$last
		claude_target="commits $base..$last"
		codex_target="the commits after $base up to and including $last (HEAD)"
	else
		last=$(full_hash "$arg")
		name=$last
		claude_target="commit $last"
		codex_target="commit $last (HEAD)"
	fi

	if ! command -v bwrap > /dev/null; then
		echo "review-commits: bwrap is not on PATH; install bubblewrap (pkgs.bubblewrap on NixOS), which runs each codex reviewer in a sandbox" >&2
		exit 2
	fi
	local prompts reviewer
	prompts=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../review-prompts
	for reviewer in "${codex_reviewers[@]}"; do
		if [[ ! -r $prompts/codex-${reviewer#*:}.md ]]; then
			echo "review-commits: no prompt for the focus of $reviewer: $prompts/codex-${reviewer#*:}.md" >&2
			exit 2
		fi
	done

	local top
	top=$(git rev-parse --show-toplevel)
	trap cleanup EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/review-commits.XXXXXX")
	git clone --quiet --shared --no-checkout "$top" "$tmp/repo"
	git -C "$tmp/repo" checkout --quiet --detach "$last"
	cd "$tmp/repo"
	local -a sandbox codex_options claude_options
	make_sandbox
	codex_home_options

	# Each reviewer runs in a sandbox of its own. A codex reviewer reads its
	# prompt from stdin, and a Claude reviewer gets /dev/null as its stdin, so
	# that it doesn't wait for input. setsid makes each reviewer the leader of a
	# new session and process group, keeping its PID.
	local reviews=$HOME/.ai-code-reviews model transcript
	# Each reviewer's model and PID, in the order that the reviewers started
	local -a models=() pids=()
	for reviewer in "${codex_reviewers[@]}"; do
		model=${reviewer%%:*}
		mkdir -p "$reviews/$model"
		{
			echo "You are reviewing code changes made by another engineer: $codex_target in this repository. Use git to see the changes and their commit messages."
			echo
			cat "$prompts/codex-${reviewer#*:}.md"
			echo
			cat "$prompts/codex-common.md"
		} > "$tmp/$model.prompt"
		setsid "${sandbox[@]}" "${codex_options[@]}" codex exec -c "model=$model" -c model_reasoning_effort=xhigh - < "$tmp/$model.prompt" \
			> "$reviews/$model/$name" 2> "$reviews/$model/$name.log" &
		models+=("$model")
		pids+=($!)
	done
	# /code-review runs in a subagent, which uses the model in
	# CLAUDE_CODE_SUBAGENT_MODEL (if the environment or the user's settings set
	# it) instead of --model; --settings overrides both, so that the reviewer's
	# model (or the fallback model) reviews.
	for model in "${claude_reviewers[@]}"; do
		transcript=$reviews/$model/$name.transcript
		rm -rf "$transcript"
		mkdir -p "$transcript"
		claude_home_options "$transcript"
		setsid "${sandbox[@]}" "${claude_options[@]}" claude -p --model "$model" --fallback-model "$claude_fallback_model" \
			--settings "{\"env\":{\"CLAUDE_CODE_SUBAGENT_MODEL\":\"$model\"}}" --effort xhigh \
			"/code-review xhigh $claude_target" < /dev/null > "$reviews/$model/$name" 2>&1 &
		models+=("$model")
		pids+=($!)
	done
	echo "review-commits: started ${#models[@]} reviews of $name in $tmp/repo"

	local i file status failed=0
	for i in "${!pids[@]}"; do
		file=$reviews/${models[$i]}/$name
		status=0
		wait "${pids[$i]}" || status=$?
		echo
		echo "=== ${models[$i]} (exit status $status): $file"
		cat "$file"
		if (( status != 0 )); then
			failed=1
			# A Claude reviewer prints everything to its review, so only a
			# codex reviewer has a transcript of text
			if [[ -e $file.log ]]; then
				echo "--- the end of its transcript, $file.log:"
				tail -n 20 "$file.log"
			fi
		fi
	done
	return $failed
}

main "$@"
