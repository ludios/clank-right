{{#
The master AGENTS.md. clank-right renders it once per repository with:

- every option from the repository's `<!-- clank-right ... -->` header, with
  defaults filled in (the fields of ProjectOptions in src/config.ts);
- options_text:     those options as the human wrote them, carried over;
- project_sections: the repository's own H1 sections, kept verbatim;
- web_design_body:  the existing "# Web design" body, for web_design = "custom".

Facts that drift over time live in the `set` tags right below. The text that
chatbot.vto shares lives in the partials that both of them include.

Whitespace discipline, since the output is not post-processed: an optional
block starts with a blank line and ends without one, so that the fixed text
around it reads the same whether or not the block is emitted.
#}}
{{ set nixos_version = "26.05" }}
{{ set curl_chrome   = "curl_chrome150" }}
{{ set claude_model  = "Claude Fable 5.1" }}
{{ set chatgpt_model = "ChatGPT 6 Astra" }}
{{ set codex_model   = "gpt-6-astra" }}
{{ set codex_name    = "GPT-6-Astra" }}
{{ set tools = ["ripgrep", "ripgrep-all", "node", "deno", "pnpm", "oxfmt", "oxlint", "jq", "python3", "uv", ...tools_extra, "psql", "ephemeralpg (bin: pg_tmp)", "google-chrome", "curl-impersonate", "gcc", "go", "rustc", "cargo", "patchelf", "zip", "unzip", "zstd", "dmesg", "perf", "hyperfine", "codex", "claude"] }}
{{# What the options imply. #}}
{{ set node   = languages.some((l) => ["typescript", "javascript", "svelte"].includes(l)) }}
{{ set svelte = languages.includes("svelte") }}
{{ set braces = node || languages.includes("c") || languages.includes("cpp") }}
{{ set sql    = languages.includes("sql") }}
{{ set sandbox     = sandbox_note ? sandbox_note + "; " : "" }}
{{ set checker     = svelte ? "svelte-check" : "tsc" }}
{{ set commit_verb = (checks.length > 0 || extra.checks) ? "Then automatically" : "Automatically" }}
