{{ else if check == "pnpm" }}

At the workspace root:

	pnpm lint  # runs oxlint
	pnpm check # runs {{ checker }}
	pnpm test  # runs vitest
{{ else if check == "cargo" }}

At the workspace root:

	cargo test
{{ /if }}
